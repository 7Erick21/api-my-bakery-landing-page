{
  "kind": "singleType",
  "collectionName": "informations",
  "info": {
    "singularName": "information",
    "pluralName": "informations",
    "displayName": "Information"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "location": {
      "type": "string",
      "required": true
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "phone": {
      "type": "string",
      "maxLength": 9,
      "required": true,
      "regex": "^\\d{9}$"
    }
  }
}
