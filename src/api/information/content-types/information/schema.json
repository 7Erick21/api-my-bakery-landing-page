{
  "kind": "singleType",
  "collectionName": "informations",
  "info": {
    "singularName": "information",
    "pluralName": "informations",
    "displayName": "Information"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "location": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "integer",
      "required": true,
      "max": 9
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "schedules": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::schedule.schedule",
      "private": true
    },
    "social_networks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::social-network.social-network"
    }
  }
}
